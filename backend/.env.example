PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ef_matchday
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Resend (https://resend.com) — key should look like re_...
RESEND_API_KEY=re_your_resend_api_key_here
# For testing without a domain, use onboarding@resend.dev (sends only to your Resend account email).
# After verifying a domain: EMAIL_FROM="EF MatchDay <noreply@yourdomain.com>"
EMAIL_FROM=EF MatchDay <onboarding@resend.dev>
