# Public URL of this frontend (used for share links). On Vercel this is your Vercel URL.
VITE_FRONTEND_URL=http://localhost:3000

# Backend API origin — REQUIRED for production (Vercel).
# Leave empty in local dev so Vite's proxy (/api → localhost:5000) is used.
# Production example: https://your-api.onrender.com
VITE_API_URL=
